# Jenkins Infrastructure Configuration
# Copy this file to .env and customize for your environment.
# NEVER commit the real .env file - it is gitignored.

# === Jenkins Image ===
# Full tag of the jenkins/jenkins base image (encodes version + JDK).
# Used as the image tag in docker-compose.yml - changing this pulls a new image.
# Verify the tag exists: https://hub.docker.com/r/jenkins/jenkins/tags
# Examples: 2.462.1-jdk17, 2.462.1-jdk21, 2.452.1-jdk17
JENKINS_IMAGE_TAG=2.462.1-jdk17

# === Jenkins Java Options ===
# JVM flags passed via JAVA_OPTS inside the container.
JENKINS_JAVA_OPTS=-Djava.awt.headless=true -Xmx2048m -Xms512m

# === Jenkins CLI Options (JENKINS_OPTS) ===
# Jenkins CLI args only (e.g. --prefix=/jenkins). Leave empty if unused.
# Do NOT put JVM flags (-Xmx, -D...) here - use JENKINS_JAVA_OPTS instead.
# JENKINS_OPTS=

# === Network ===
# Jenkins HTTP port (host-side mapping)
JENKINS_PORT=8080
# Jenkins agent port for JNLP agents (host-side mapping)
JENKINS_AGENT_PORT=50000

# === Backup Settings ===
BACKUP_RETENTION_DAYS=30

# === Jenkins Auth (for backup/restore scripts) ===
# After completing the Jenkins setup wizard, security is enabled and the
# backup/restore scripts need credentials to call the Jenkins API (quietDown,
# safeExit, etc.). Create an API token in Jenkins: User > Configure > API Token.
# Leave empty only if Jenkins security is disabled (not recommended).
JENKINS_USER=
JENKINS_API_TOKEN=

# === Timezone (optional) ===
TZ=Asia/Phnom_Penh

# === Notes ===
# Plugins, credentials, jobs, and Jenkins configuration are managed via
# the Jenkins UI and persisted in the Docker volume (jenkins_home).
# Use ./scripts/backup.sh to capture state and ./scripts/restore.sh to restore.
# There is no plugins.txt or JCasC - everything is UI-managed.
