# Jenkins Infrastructure Configuration
# Copy this file to .env and customize for your environment

# Jenkins LTS Version (pinned for reproducibility)
JENKINS_VERSION=2.462.1

# Jenkins Java Options
JENKINS_JAVA_OPTS=-Djava.awt.headless=true -Xmx2048m -Xms512m

# Jenkins HTTP Port (internal container port)
JENKINS_PORT=8080

# Jenkins Agent Port (for JNLP agents)
JENKINS_AGENT_PORT=50000

# Backup settings
BACKUP_RETENTION_DAYS=30

# Timezone (optional)
# TZ=UTC
